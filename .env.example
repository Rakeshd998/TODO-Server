PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/todo_db?retryWrites=true&w=majority
ACCESS_TOKEN_SECRET=<generate-a-strong-random-secret>
REFRESH_TOKEN_SECRET=<generate-a-different-strong-random-secret>
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Nodemailer (Gmail) — use an App Password, NOT your real Gmail password
# https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=<your-gmail-address>
EMAIL_PASS=<your-gmail-app-password>

# ─── Chat Infrastructure (optional) ──────────────────────────────────────────
# Without Redis: presence is tracked in memory and Socket.IO runs single-node.
# Without Kafka: messages are saved and delivered directly.
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=chat-messages
